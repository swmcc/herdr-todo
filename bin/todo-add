#!/bin/sh
# todo-add: asks for a title, home, business or work, and labels, then adds the task.
# Runs inside the list (n) and as its own small popup (Todo: add).
set -u
BIN=$(cd "$(dirname "$0")" && pwd)

clear
printf '\n  ✨ \033[1mNew to-do\033[0m  \033[2m(ctrl-c to cancel)\033[0m\n\n'
printf '  What needs doing?\n  › '
read -r title || exit 0
[ -n "$title" ] || exit 0

printf '\n  🏠 home, 🦍 SkillfulGorilla or 🏢 work? [h/s/w] › '
read -r where || exit 0
case "$where" in s*|S*|b*|B*) side=biz ;; w*|W*) side=work ;; *) side=home ;; esac

# Labels as coloured pills to pick from: tab picks, enter adds, esc for none,
# ctrl-c cancels the whole add.
# Falls back to typing short names when fzf isn't there.
pick_labels() {
  "$BIN/todo-cli" labels 2>/dev/null | LC_ALL=C awk -F '\t' '
    function hex(h,  i, v) {
      v = 0; h = tolower(h)
      for (i = 1; i <= length(h); i++) v = v * 16 + index("0123456789abcdef", substr(h, i, 1)) - 1
      return v
    }
    $1 == "🏠 domestic" || $1 == "🦍 skillfulgorilla" || $1 == "🏢 work" { next }
    {
      c = $3; sub(/^#/, "", c)
      r = hex(substr(c, 1, 2)); g = hex(substr(c, 3, 2)); b = hex(substr(c, 5, 2))
      fg = (0.299 * r + 0.587 * g + 0.114 * b > 150) ? "30" : "97"
      # Fields: full name (returned), the pill (searched), the description (shown only).
      printf "%s\t\033[48;2;%d;%d;%dm\033[%sm %s \033[0m\t \033[2m%s\033[0m\n", $1, r, g, b, fg, $1, $2
    }' |
    fzf --ansi --multi --delimiter '\t' --with-nth 2.. --nth 1 \
      --layout reverse --height 100% --style full --gutter ' ' --marker '✔ ' --pointer '▌' \
      --input-label ' 🔖 labels ' --prompt '  ' \
      --header 'tab pick · enter add · esc no labels · ctrl-c cancel' \
      --color 'hl:#f0b37e:bold,hl+:#f0b37e:bold,pointer:#8250df,marker:#1f883d,input-label:#0969da:bold,header:#6e7781' \
      --bind 'esc:become(true)' > "$picks" || return
  cut -f 1 "$picks"
}

set --
if command -v fzf >/dev/null 2>&1; then
  picks=$(mktemp)
  trap 'rm -f "$picks"' EXIT
  picked=$(pick_labels) || exit 0
  # One label per line; full names, so ones with spaces ("🚧 in progress") stay whole.
  while IFS= read -r l; do [ -n "$l" ] && set -- "$@" "$l"; done <<EOF_LABELS
$picked
EOF_LABELS
else
  printf '\n  Labels, short names \033[2m(e.g. car urgent, enter for none)\033[0m\n  › '
  read -r labels || exit 0
  # shellcheck disable=SC2086 # labels are words on purpose
  set -- $labels
fi

clear
printf '\n  ✨ \033[1m%s\033[0m\n' "$title"
if out=$("$BIN/todo-cli" "$side" "$title" "$@" 2>&1); then
  printf '\n  🎉 \033[32mAdded\033[0m %s\n' "$out"
  [ $# -gt 0 ] && printf '  🔖 %s\n' "$*"
  "$BIN/todo-pane" fetch   # so the list has it next time it opens
  sleep 1
else
  printf '\n  ⚠️  \033[31m%s\033[0m\n' "$out"
  sleep 3
fi
